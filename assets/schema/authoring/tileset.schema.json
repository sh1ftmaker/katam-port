{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "katam:schema/tileset",
  "title": "katam foreground tileset (katam-tileset/1)",
  "description": "The playfield's 8x8 tiles (VRAM char block 2) as an indexed PNG, 4 bits per pixel, 32 tiles per row; plus looping tile animations. The PNG palette is only a preview: pixel indices 0-15 are the data, colours come from the room's palette bank. Index 0 is transparent.",
  "type": "object",
  "required": ["format", "id", "image", "tileCount"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "katam-tileset/1"},
    "id": {"$ref": "katam:schema/common#/$defs/tilesetRef"},
    "bind": {"type": "object", "properties": {"index": {"type": "integer"}}, "additionalProperties": false},
    "image": {"type": "string", "description": "PNG next to this file."},
    "tileCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024,
      "description": "Tiles to read from the image (row-major). The playfield can address 768 (char block 2-3)."
    },
    "roomTag": {
      "type": "integer",
      "description": "Authoring annotation kept from the original data (a room id); not read by the game."
    },
    "previewPalette": {"$ref": "katam:schema/common#/$defs/paletteRef"},
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tile", "tiles", "frames"],
        "additionalProperties": false,
        "properties": {
          "tile": {"type": "integer", "description": "First tile overwritten."},
          "tiles": {"type": "integer", "description": "Tiles per chunk."},
          "chunks": {"type": "integer", "description": "Chunks per frame (default 1)."},
          "chunkStride": {
            "type": "integer",
            "description": "Tiles between chunks, source and destination (default 32 = one sheet row)."
          },
          "frames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["gfxTile", "duration"],
              "additionalProperties": false,
              "properties": {
                "gfxTile": {"type": "integer", "description": "First tile of this frame in animImage."},
                "duration": {"type": "integer", "minimum": 1, "description": "frames (60 Hz)"},
                "pad": {"type": "integer"}
              }
            }
          }
        }
      }
    },
    "animImage": {"type": "string"},
    "animTileCount": {"type": "integer"}
  }
}
