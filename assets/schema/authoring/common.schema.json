      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[abcdefghijklmnopqrstuvwxyzABCEFGIJKLMNOPQRSTUVWXYZ0123456789DH.#=~\\^%\\-+:;,_*@!$&|/<>?()[\\]{}'`]*$"
      },
