{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "katam:schema/common",
  "title": "Shared definitions for katam authoring files",
  "$defs": {
    "roomRef": {
      "type": "string",
      "pattern": "^room:[a-z0-9_]+/[a-z0-9_]+$",
      "description": "A room id, \"room:<area>/<name>\", e.g. \"room:rainbow_route/126\" (vanilla) or \"room:my_mod/sky_garden\". \"room:vanilla/<number>\" also resolves for vanilla rooms."
    },
    "tilesetRef": {
      "type": "string",
      "pattern": "^tileset:[a-z0-9_]+/[a-z0-9_]+$",
      "description": "A foreground tileset id, e.g. \"tileset:vanilla/29\"."
    },
    "paletteRef": {
      "type": "string",
      "pattern": "^palette:[a-z0-9_]+/[a-z0-9_]+$",
      "description": "A foreground palette id, e.g. \"palette:vanilla/29\". Usually the same number as the tileset."
    },
    "backgroundRef": {
      "type": "string",
      "pattern": "^background:[a-z0-9_]+/[a-z0-9_]+$",
      "description": "A background (parallax layer) id, e.g. \"background:vanilla/28\"."
    },
    "tileToken": {
      "type": "string",
      "pattern": "^[0-9a-f]{3}[.hvx][0-9a-f]$",
      "description": "One 8x8 tilemap entry, \"TTTfP\": TTT = tile index in hex (000-3ff), f = flip (. none, h horizontal, v vertical, x both), P = palette bank in hex. \"000.0\" is tile 0 unflipped in bank 0."
    },
    "metatile": {
      "type": "string",
      "pattern": "^[0-9a-f]{3}[.hvx][0-9a-f]( [0-9a-f]{3}[.hvx][0-9a-f]){3}$",
      "description": "A 16x16 cell drawn as four 8x8 tile tokens, \"TL TR BL BR\", e.g. \"001.0 002.0 021.0 022.0\"."
    },
    "collisionValue": {
      "description": "A collision (metatile attribute) value: an index 0-255 into the game's terrain table gCollisionAttributes. Named values come from the semantics registry.",
